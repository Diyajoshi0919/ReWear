# Copy this file to backend/.env and fill in your values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rewear

# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this API, comma-separated
CLIENT_URL=http://localhost:5173,https://rewear-alpha.vercel.app

# Cloudinary (dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Gmail address + App Password for swap notification emails
EMAIL_USER=
EMAIL_PASS=

# Optional: URL of the Python CLIP service (backend/clip_service)
CLIP_SERVICE_URL=
